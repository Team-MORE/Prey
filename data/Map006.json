"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[1]죄수B\\c[0]"]},{"code":401,"indent":0,"parameters":["참나, 리스 양반. 세상 물정을 너무 모르는구먼! "]},{"code":401,"indent":0,"parameters":["광산이 고갈되고 우리 마을이 몰락한 게"]},{"code":401,"indent":0,"parameters":["그 인간 잘못이 아니라고?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[1]죄수B\\c[0]"]},{"code":401,"indent":0,"parameters":["우리가 광산의 생산량이 점점 줄어들고 있을 때 "]},{"code":401,"indent":0,"parameters":["우리가 손 놓고 보고만 있었는지 알아?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[1]죄수B\\c[0]"]},{"code":401,"indent":0,"parameters":["그 대안으로 폐광산이 있던 자리에 공장을 지으려고 하니까 "]},{"code":401,"indent":0,"parameters":["그 윗동네 놈들이 뭐라고 했는지 아나?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[1]죄수B\\c[0]"]},{"code":401,"indent":0,"parameters":["우리보고 돈도 많으면서 욕심부리지 말라고 하더군. "]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[1]죄수B\\c[0]"]},{"code":401,"indent":0,"parameters":["결국 공장은 윗동네 놈들이 짓게 되었고, "]},{"code":401,"indent":0,"parameters":["우리 마을은 몰락의 길을 걸을 수밖에 없었던 거야."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[1]죄수B\\c[0]"]},{"code":401,"indent":0,"parameters":["그리고 우리가 공장을 짓는 것을 가장 큰 목소리로 반대했던 인간이 "]},{"code":401,"indent":0,"parameters":["바로 그 개 같은 자식이라고!"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[17]리스\\c[0]"]},{"code":401,"indent":0,"parameters":["그렇다 해도 이런 식으로 폭력을 행사하는 것은 "]},{"code":401,"indent":0,"parameters":["용납할 수 없습니다."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[1]죄수B\\c[0]"]},{"code":401,"indent":0,"parameters":["거, 말이 안 통하네. 얼마 전에 있었던 그 테러 사건 있잖아? "]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\c[1]죄수B\\c[0]"]},{"code":401,"indent":0,"parameters":["그 자식이 테러의 주동자가 우리 마을 사람이니 "]},{"code":401,